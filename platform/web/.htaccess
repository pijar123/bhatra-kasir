# Semua subdomain toko (*.domain) memakai folder yang sama; halaman toko membaca nama toko dari subdomain.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# Domain utama tanpa nama toko → halaman produk
RewriteCond %{HTTP_HOST} ^(www\.)?dapurin\.id$ [NC]
RewriteCond %{QUERY_STRING} !(^|&)(toko|o)= [NC]
RewriteRule ^$ /home.html [L]

AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
